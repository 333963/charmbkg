# Węzeł DAG DNET etap 5a — cały wariant na GPU (5 foldów + łączenie; VARS node, args, wait, soft, penv z dn5.dag).
# Job, który nie wystartuje (albo zostanie wstrzymany) przez $(wait) s od wysłania, usuwa się sam → węzeł i DAG padają → awaryjnie DN5_TRAIN=cpu.
Q          = /afs/cern.ch/user/k/klyczak/private/charm_q/Q_lxplus
universe   = vanilla
executable = /bin/bash
arguments  = $(Q)/dnet5/dn5_job.sh $(args)
output     = $(Q)/logs/dnet5/dn5_$(node).$(ClusterId).out
error      = $(Q)/logs/dnet5/dn5_$(node).$(ClusterId).err
log        = $(Q)/logs/dnet5/dn5.log
request_cpus   = 4
request_gpus   = 1
# Tesla V100 (capability 7.0) nie jest obsługiwana przez torch 2.11 z LCG_110_cuda
require_gpus   = Capability > 7.0
request_memory = 16GB
request_disk   = 8GB
+JobFlavour    = "longlunch"
periodic_remove = ((JobStatus == 1) || (JobStatus == 5)) && ((time() - QDate) > $(wait))
should_transfer_files = NO
getenv     = False
environment = "$(penv) DN5_SOFTNODE=$(soft)"
queue
