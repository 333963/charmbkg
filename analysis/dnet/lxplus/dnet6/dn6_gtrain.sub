# Węzeł DAG DNET etap 6 — całe ziarno na GPU (5 foldów + łączenie; VARS node, args, wait, penv z dn6.dag).
# Job, który nie wystartuje (albo zostanie wstrzymany) przez $(wait) s od wysłania, usuwa się sam → węzeł i DAG padają → tryb CPU (dn6_switch.sh cpu / ORCH).
Q          = /afs/cern.ch/user/k/klyczak/private/charm_q/Q_lxplus
universe   = vanilla
executable = /bin/bash
arguments  = $(Q)/dnet6/dn6_job.sh $(args)
output     = $(Q)/logs/dnet6/dn6_$(node).$(ClusterId).out
error      = $(Q)/logs/dnet6/dn6_$(node).$(ClusterId).err
log        = $(Q)/logs/dnet6/dn6.log
request_cpus   = 4
request_gpus   = 1
# Tesla V100 (capability 7.0) nie jest obsługiwana przez torch 2.11 z LCG_110_cuda
require_gpus   = Capability > 7.0
request_memory = 16GB
request_disk   = 8GB
+JobFlavour    = "longlunch"
periodic_remove = ((JobStatus == 1) || (JobStatus == 5)) && ((time() - QDate) > $(wait))
should_transfer_files = NO
getenv     = False
environment = "$(penv) DN6_SOFTNODE=0"
queue
