# Węzeł DAG DNET etap 4 — trening sieci na GPU (19.11, po sondzie etapu 5: fold tr.H+e04 w 52 s na A100; CPU ~50 min/fold).
# VARS jak dn4.sub (cpus/mem/flavour z VARS są ignorowane). 1 job = 1 wariant, 5 foldów po kolei.
Q          = /afs/cern.ch/user/k/klyczak/private/charm_q/Q_lxplus
universe   = vanilla
executable = /bin/bash
arguments  = $(Q)/dnet4/dn4_job.sh $(args)
output     = $(Q)/logs/dnet4/dn4_$(node).$(ClusterId).out
error      = $(Q)/logs/dnet4/dn4_$(node).$(ClusterId).err
log        = $(Q)/logs/dnet4/dn4.log
request_cpus   = 4
request_gpus   = 1
# Tesla V100 (capability 7.0) nie jest obsługiwana przez torch 2.11 z LCG_110_cuda
require_gpus   = Capability > 7.0
request_memory = 16GB
request_disk   = 8GB
+JobFlavour    = "workday"
should_transfer_files = NO
getenv     = False
environment = "$(penv) DN4_SOFTNODE=$(soft) DN4_GPU=1"
queue
