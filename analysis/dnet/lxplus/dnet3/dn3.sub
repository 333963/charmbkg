# Węzeł DAG DNET etap 3 — CPU (VARS node, args, cpus, mem, disk, flavour, penv z dn3.dag). Trening na GPU: dn3_gpu.sub.
Q          = /afs/cern.ch/user/k/klyczak/private/charm_q/Q_lxplus
universe   = vanilla
executable = /bin/bash
arguments  = $(Q)/dnet3/dn3_job.sh $(args)
output     = $(Q)/logs/dnet3/dn3_$(node).$(ClusterId).out
error      = $(Q)/logs/dnet3/dn3_$(node).$(ClusterId).err
log        = $(Q)/logs/dnet3/dn3.log
request_cpus   = $(cpus)
request_memory = $(mem)
request_disk   = $(disk)
+JobFlavour    = "$(flavour)"
should_transfer_files = NO
getenv     = False
environment = "$(penv)"
queue
