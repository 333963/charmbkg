# TAGGED — jeden węzeł (mapa uid → zdarzenie z evtable + tabela kandydatów tagowanych + histogramy inkluzywne; ~15 min, 1 rdzeń).
Q          = /afs/cern.ch/user/k/klyczak/private/charm_q/Q_lxplus
universe   = vanilla
executable = /bin/bash
arguments  = $(Q)/tagged/tg_job.sh
