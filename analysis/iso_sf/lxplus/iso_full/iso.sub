# Węzeł DAG ISO-FULL (VARS step, part, cpus, mem, disk, flavour, penv z iso.dag).
Q          = /afs/cern.ch/user/k/klyczak/private/charm_q/Q_lxplus
universe   = vanilla
executable = /bin/bash
arguments  = $(Q)/iso_full/iso_job.sh $(step) $(part)
output     = $(Q)/logs/iso_full/iso_$(step)_$(part).$(ClusterId).out
error      = $(Q)/logs/iso_full/iso_$(step)_$(part).$(ClusterId).err
log        = $(Q)/logs/iso_full/iso.log
request_cpus   = $(cpus)
request_memory = $(mem)
request_disk   = $(disk)
+JobFlavour    = "$(flavour)"
should_transfer_files = NO
getenv     = False
environment = "$(penv)"
queue
